<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>@ViewData["Title"] - Employee Directory</title>
    <style>
        :root { font-family: "Segoe UI", sans-serif; background: #f3f6f4; color: #202b28; }
        * { box-sizing: border-box; }
        body { margin: 0; min-height: 100vh; }
        header { background: #174b3d; color: #fff; }
        .topbar, main { width: min(1080px, calc(100% - 32px)); margin: 0 auto; }
        .topbar { min-height: 64px; display: flex; align-items: center; justify-content: space-between; gap: 20px; }
        .brand { color: inherit; font-size: 18px; font-weight: 700; text-decoration: none; }
        .nav-link { color: #e0eee8; text-decoration: none; }
        main { padding: 38px 0 64px; }
        h1 { margin: 0; font-size: 30px; }
        .subtitle { margin: 8px 0 0; color: #61716b; }
        .page-heading { display: flex; align-items: end; justify-content: space-between; gap: 20px; margin-bottom: 24px; }
        .button { display: inline-flex; align-items: center; justify-content: center; min-height: 40px; padding: 0 16px; border: 0; border-radius: 5px; background: #17684f; color: #fff; font: inherit; font-weight: 600; text-decoration: none; cursor: pointer; }
        .button:hover { background: #10513e; }
        .button-secondary { background: #e4ece8; color: #244238; }
        .button-secondary:hover { background: #d3e1da; }
        .surface { overflow: hidden; border: 1px solid #dce5df; border-radius: 6px; background: #fff; }
        .table-wrap { overflow-x: auto; }
        table { width: 100%; border-collapse: collapse; text-align: left; }
        th, td { padding: 14px 18px; border-bottom: 1px solid #e8eeea; white-space: nowrap; }
        th { background: #f7faf8; color: #53645d; font-size: 12px; text-transform: uppercase; }
        tbody tr:last-child td { border-bottom: 0; }
        .empty-state { padding: 42px 20px; text-align: center; color: #61716b; }
        .empty-state strong { display: block; margin-bottom: 8px; color: #263a32; }
        .form-surface { max-width: 640px; padding: 24px; }
        .field { margin-bottom: 18px; }
        label { display: block; margin-bottom: 6px; font-size: 14px; font-weight: 600; }
        input { width: 100%; min-height: 42px; padding: 9px 11px; border: 1px solid #cbd7d0; border-radius: 4px; background: #fff; color: inherit; font: inherit; }
        input:focus { outline: 2px solid #6daf91; outline-offset: 1px; }
        .validation-summary-errors, .field-validation-error { color: #a33131; font-size: 13px; }
        .validation-summary-errors ul { margin-top: 0; padding-left: 20px; }
        .form-actions { display: flex; gap: 10px; margin-top: 24px; }
        @@media (max-width: 600px) {
            main { padding-top: 28px; }
            .page-heading { align-items: start; flex-direction: column; }
            h1 { font-size: 26px; }
            .form-surface { padding: 18px; }
            th, td { padding: 12px; }
        }
    </style>
</head>
<body>
    <header>
        <div class="topbar">
            <a class="brand" asp-controller="Employees" asp-action="Index">Employee Directory</a>
            <a class="nav-link" asp-controller="Employees" asp-action="Index">Employees</a>
        </div>
    </header>
    <main>
        @RenderBody()
    </main>
</body>
</html>